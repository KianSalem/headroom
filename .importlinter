[importlinter]
root_package = headroom
# Required to reason about anthropic, which lives outside the root package.
include_external_packages = True

[importlinter:contract:no-llm-in-core]
name = Deterministic core imports nothing from anthropic
# SPEC 15: analysis/, dsp/ and target/ are the measurement and processing core.
# If an LLM can reach into them, the objective function is no longer
# independent of the thing being graded, and "no LLM-as-judge in the primary
# metric" stops being enforceable by anything but discipline.
type = forbidden
source_modules =
    headroom.analysis
    headroom.dsp
    headroom.target
forbidden_modules =
    anthropic

[importlinter:contract:llm-confined-to-one-module]
name = Only agent.client may reach the model
# The agent is where an LLM belongs, but not all of it. Routing, the tool
# layer, the briefing filter and the working memory are the parts whose
# behaviour the evaluation actually claims things about, so they are held to
# the same rule as the core: no path to anthropic, therefore no API key needed
# to test them, therefore they are tested on every fork's pull request.
type = forbidden
source_modules =
    headroom.control
    headroom.baselines
    headroom.agent.roles
    headroom.agent.tools
    headroom.agent.briefing
    headroom.agent.memory
    headroom.agent.specialist
    headroom.agent.supervisor
    headroom.agent.cassette
    headroom.agent.pricing
forbidden_modules =
    anthropic

[importlinter:contract:core-layering]
name = Core layers point one way
# analysis knows nothing about processing or targets; dsp and target build on
# analysis. Keeps the feature vector definable without reference to how audio
# gets changed.
type = layers
layers =
# conformance is the oracle that holds a second implementation against this
# one. Nothing measured may import it, or the metric could come to depend on
# its own checker.
    headroom.conformance
    headroom.agent
    headroom.baselines
    headroom.control
    headroom.target
    headroom.dsp
    headroom.analysis
    headroom.audio
