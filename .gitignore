__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.import_linter_cache/
.coverage
htmlcov/

# Audio: never commit the corpus or large binaries. Git ignore patterns are
# case-sensitive on Linux, so extensions are spelled case-insensitively.
audio/*
corpus/
*.[wW][aA][vV]
*.[aA][iI][fF][fF]
*.[fF][lL][aA][cC]
*.[mM][pP]3
*.[mM]4[aA]
*.[oO][gG][gG]

# Scratch run artifacts. Published traces live in results/ and are committed.
traces/
reports/
*.sqlite
*.db

.DS_Store
.idea/
.vscode/

# --- Re-inclusions. Must come last: later patterns win. ---
# Tiny synthetic test fixtures and the results tree (traces, manifests, and
# the synthetic listening page's MP3s) are committed so the results table is
# reproducible offline. `report --html` refuses to write audio for any corpus
# whose manifest is not marked redistributable, so nothing licensed can land
# under results/ by accident.
!tests/fixtures/
!tests/fixtures/**
!results/
!results/**
