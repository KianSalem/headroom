# Shared look for every headroom demo. Sourced by the tapes beside it, so a
# change here restyles all of them. No Output directive: that belongs to the
# tape being recorded.
Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 15
Set LineHeight 1.2
Set Padding 26
Set Framerate 20
Set TypingSpeed 40ms
Set WaitTimeout 90s
Set Theme { "background": "#11131a", "foreground": "#c8d0e0", "cursor": "#e8b17a", "selection": "#2a2f3d", "black": "#11131a", "red": "#e88388", "green": "#a7c785", "yellow": "#e8b17a", "blue": "#7fa7d4", "magenta": "#c79ad4", "cyan": "#87c7c7", "white": "#c8d0e0", "brightBlack": "#5b6273", "brightRed": "#e88388", "brightGreen": "#a7c785", "brightYellow": "#e8b17a", "brightBlue": "#7fa7d4", "brightMagenta": "#c79ad4", "brightCyan": "#87c7c7", "brightWhite": "#eef1f7" }
